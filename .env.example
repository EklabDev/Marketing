# Example runtime environment for local/docker deploys.
# Copy to .env for local development (never commit real secrets).

NEXT_PUBLIC_SITE_URL=https://eklab.xyz

# Unlisted Power SEO analytics at /seo-analytics
SEO_ANALYTICS_USERNAME=marketing
SEO_ANALYTICS_PASSWORD=change-me
SEO_ANALYTICS_SECRET=change-me-too
SQLITE_PATH=./data/seo.db

